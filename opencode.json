{
  "$schema": "https://opencode.ai/config.json",

  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",

    "bash": {
      "*": "ask",

      "pytest*": "allow",
      "python -m pytest*": "allow",
      "ruff*": "allow",
      "mypy*": "allow",
      "git status": "allow",
      "git status --short": "allow",
      "git rev-parse*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "uv *": "allow",
      "pip install*": "allow",

      "docker compose up*": "allow",
      "docker compose ps*": "allow",
      "psql * -f schema.sql": "ask",

      "rm *": "deny",
      "rm -rf*": "deny",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git checkout .": "deny",
      "docker compose down -v*": "deny",
      "psql *DROP*": "deny",
      "psql *TRUNCATE*": "deny",
      "alembic downgrade*": "deny"
    }
  },

  "formatter": {
    "ruff": {
      "command": ["ruff", "format", "$FILE"],
      "extensions": [".py"]
    }
  }
}
